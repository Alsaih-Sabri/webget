---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(service => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const allServices = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order);

const currentIndex = allServices.findIndex(s => s.id === service.id);
const prevService = currentIndex > 0 ? allServices[currentIndex - 1] : null;
const nextService = currentIndex < allServices.length - 1 ? allServices[currentIndex + 1] : null;

// Service-specific icons mapping
const serviceIcons: Record<string, string> = {
  'web-design': `<svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  'web-development': `<svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
  'seo-optimization': `<svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10h-2v4m0-4V8" /></svg>`,
  'graphic-design': `<svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>`,
  'photography': `<svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
  'video-production': `<svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>`,
};

// Service-specific stats
const serviceStats: Record<string, Array<{value: string, label: string}>> = {
  'web-design': [
    { value: '200+', label: 'Websites Designed' },
    { value: '98%', label: 'Client Satisfaction' },
    { value: '< 3s', label: 'Avg Load Time' },
    { value: '24/7', label: 'Support' },
  ],
  'web-development': [
    { value: '150+', label: 'Apps Built' },
    { value: '99.9%', label: 'Uptime' },
    { value: '100', label: 'Lighthouse Score' },
    { value: '50+', label: 'Technologies' },
  ],
  'seo-optimization': [
    { value: '300%', label: 'Avg Traffic Increase' },
    { value: 'Top 3', label: 'Ranking Results' },
    { value: '500+', label: 'Keywords Ranked' },
    { value: '150%', label: 'Lead Growth' },
  ],
  'graphic-design': [
    { value: '1000+', label: 'Designs Created' },
    { value: '100%', label: 'Original Work' },
    { value: '48h', label: 'Fast Turnaround' },
    { value: '∞', label: 'Revisions' },
  ],
  'photography': [
    { value: '500+', label: 'Photo Shoots' },
    { value: '4K', label: 'Resolution' },
    { value: '24h', label: 'Delivery' },
    { value: 'RAW', label: 'Files Included' },
  ],
  'video-production': [
    { value: '200+', label: 'Videos Produced' },
    { value: '4K/8K', label: 'Quality' },
    { value: '10M+', label: 'Views Generated' },
    { value: '5x', label: 'Engagement Boost' },
  ],
};

// Process steps for each service
const processSteps: Record<string, Array<{title: string, desc: string}>> = {
  'web-design': [
    { title: 'Discovery', desc: 'Understanding your brand, goals, and target audience' },
    { title: 'Wireframing', desc: 'Creating the blueprint and user flow structure' },
    { title: 'Design', desc: 'Crafting pixel-perfect visual designs' },
    { title: 'Review', desc: 'Iterating based on your feedback' },
  ],
  'web-development': [
    { title: 'Planning', desc: 'Architecture design and tech stack selection' },
    { title: 'Development', desc: 'Building with clean, scalable code' },
    { title: 'Testing', desc: 'Rigorous QA across all devices' },
    { title: 'Launch', desc: 'Deployment with zero downtime' },
  ],
  'seo-optimization': [
    { title: 'Audit', desc: 'Comprehensive analysis of your current SEO' },
    { title: 'Strategy', desc: 'Custom roadmap for your goals' },
    { title: 'Optimize', desc: 'On-page and technical improvements' },
    { title: 'Monitor', desc: 'Ongoing tracking and refinement' },
  ],
  'graphic-design': [
    { title: 'Brief', desc: 'Understanding your vision and requirements' },
    { title: 'Concepts', desc: 'Multiple creative directions to choose from' },
    { title: 'Refine', desc: 'Perfecting the chosen direction' },
    { title: 'Deliver', desc: 'Final files in all formats needed' },
  ],
  'photography': [
    { title: 'Consult', desc: 'Planning the shoot and shot list' },
    { title: 'Capture', desc: 'Professional photography session' },
    { title: 'Edit', desc: 'Expert retouching and color grading' },
    { title: 'Deliver', desc: 'High-res files ready for use' },
  ],
  'video-production': [
    { title: 'Pre-Production', desc: 'Scripting, storyboarding, planning' },
    { title: 'Production', desc: 'Professional filming and direction' },
    { title: 'Post-Production', desc: 'Editing, effects, and sound design' },
    { title: 'Delivery', desc: 'Optimized for all platforms' },
  ],
};

const currentIcon = serviceIcons[service.id] || serviceIcons['web-design'];
const currentStats = serviceStats[service.id] || serviceStats['web-design'];
const currentProcess = processSteps[service.id] || processSteps['web-design'];
---

<Layout 
  title={service.data.title} 
  description={service.data.description}
  image={service.data.image}
>
  <article class="bg-primary min-h-screen">
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 px-4 md:px-8 overflow-hidden">
      <!-- Animated Background -->
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-br from-primary via-slate-900 to-primary"></div>
        <div class="absolute inset-0 opacity-30">
          <div class="absolute top-1/4 right-1/4 w-[500px] h-[500px] bg-accent/30 rounded-full blur-[120px] animate-float"></div>
          <div class="absolute bottom-1/4 left-1/4 w-[400px] h-[400px] bg-purple-500/30 rounded-full blur-[100px] animate-float" style="animation-delay: -3s;"></div>
          <div class="absolute top-1/2 left-1/2 w-[300px] h-[300px] bg-pink-500/20 rounded-full blur-[80px] animate-float" style="animation-delay: -1.5s;"></div>
        </div>
        <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
      </div>
      
      <div class="max-w-7xl mx-auto relative z-10">
        <a 
          href="/services" 
          class="inline-flex items-center gap-2 text-accent hover:text-accent-light transition-colors mb-8 group"
        >
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          All Services
        </a>
        
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div>
            <!-- Service Icon -->
            <div data-animate class="w-24 h-24 rounded-2xl bg-gradient-to-br from-accent to-purple-600 flex items-center justify-center text-white mb-8 shadow-lg shadow-accent/25">
              <Fragment set:html={currentIcon} />
            </div>
            
            <h1 data-animate class="text-4xl md:text-5xl lg:text-6xl font-display font-bold mb-6 delay-100">
              {service.data.title}
            </h1>
            <p data-animate class="text-xl text-white/70 mb-8 delay-200 leading-relaxed">
              {service.data.description}
            </p>
            
            <div data-animate class="flex flex-wrap gap-4 delay-300">
              <a href="/#contact" class="btn-primary">
                Get Free Quote
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
              <a href="#process" class="btn-secondary">
                See Our Process
              </a>
            </div>
          </div>
          
          <div data-animate class="delay-200 relative">
            <!-- Decorative frame -->
            <div class="absolute -inset-4 bg-gradient-to-r from-accent via-purple-500 to-pink-500 rounded-3xl opacity-20 blur-xl"></div>
            <div class="relative">
              <img 
                src={service.data.image} 
                alt={service.data.title}
                class="rounded-2xl w-full aspect-video object-cover shadow-2xl border border-white/10"
                loading="eager"
              />
              <!-- Floating badge -->
              <div class="absolute -bottom-6 -right-6 bg-gradient-to-br from-accent to-purple-600 text-white px-6 py-3 rounded-xl shadow-lg">
                <div class="text-2xl font-bold">#1</div>
                <div class="text-xs opacity-80">Rated Service</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Stats Section -->
    <section class="py-16 px-4 md:px-8 bg-slate-900/50 border-y border-white/5">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          {currentStats.map((stat, index) => (
            <div data-animate class={`text-center delay-${(index + 1) * 100}`}>
              <div class="text-4xl md:text-5xl font-display font-bold gradient-text mb-2">{stat.value}</div>
              <div class="text-white/60 text-sm">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Features Section -->
    <section id="features" class="py-20 px-4 md:px-8 bg-gradient-to-b from-primary to-slate-900">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <span data-animate class="inline-block px-4 py-2 rounded-full glass text-sm font-medium text-accent mb-4">
            What's Included
          </span>
          <h2 data-animate class="text-3xl md:text-4xl font-display font-bold delay-100">
            Everything You Need for <span class="gradient-text">Success</span>
          </h2>
        </div>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {service.data.features.map((feature, index) => (
            <div 
              data-animate 
              class={`group p-6 rounded-2xl glass hover:bg-white/10 transition-all duration-300 hover:-translate-y-1 delay-${(index + 1) * 100}`}
            >
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent to-purple-600 flex items-center justify-center flex-shrink-0 shadow-lg shadow-accent/20">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <span class="font-semibold text-lg block mb-1 group-hover:text-accent transition-colors">{feature}</span>
                  <span class="text-white/50 text-sm">Included in all packages</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Process Section -->
    <section id="process" class="py-20 px-4 md:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <span data-animate class="inline-block px-4 py-2 rounded-full glass text-sm font-medium text-accent mb-4">
            Our Process
          </span>
          <h2 data-animate class="text-3xl md:text-4xl font-display font-bold delay-100">
            How We <span class="gradient-text">Work</span>
          </h2>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {currentProcess.map((step, index) => (
            <div data-animate class={`relative delay-${(index + 1) * 100}`}>
              <!-- Connector line -->
              {index < currentProcess.length - 1 && (
                <div class="hidden lg:block absolute top-8 left-[60%] w-full h-0.5 bg-gradient-to-r from-accent to-transparent"></div>
              )}
              
              <div class="relative">
                <!-- Step number -->
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-accent to-purple-600 flex items-center justify-center text-white text-2xl font-bold mb-6 shadow-lg shadow-accent/25">
                  {index + 1}
                </div>
                
                <h3 class="text-xl font-display font-semibold mb-2">{step.title}</h3>
                <p class="text-white/60">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Content Section -->
    <section class="py-20 px-4 md:px-8 bg-gradient-to-b from-slate-900 to-primary">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <span data-animate class="inline-block px-4 py-2 rounded-full glass text-sm font-medium text-accent mb-4">
            Deep Dive
          </span>
          <h2 data-animate class="text-3xl md:text-4xl font-display font-bold delay-100">
            Learn More About <span class="gradient-text">{service.data.title}</span>
          </h2>
        </div>
        
        <div class="prose prose-invert prose-lg max-w-none
          prose-headings:font-display prose-headings:font-bold
          prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:gradient-text
          prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4
          prose-p:text-white/70 prose-p:leading-relaxed
          prose-a:text-accent prose-a:no-underline hover:prose-a:underline
          prose-strong:text-white
          prose-ul:text-white/70 prose-ol:text-white/70
          prose-li:marker:text-accent
          prose-blockquote:border-accent prose-blockquote:bg-white/5 prose-blockquote:rounded-r-xl prose-blockquote:py-4 prose-blockquote:text-white/60 prose-blockquote:italic
        ">
          <Content />
        </div>
      </div>
    </section>
    
    <!-- CTA Section -->
    <section class="py-20 px-4 md:px-8 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-accent/20 via-purple-500/20 to-pink-500/20"></div>
      <div class="absolute inset-0 bg-primary/80"></div>
      
      <div class="max-w-4xl mx-auto text-center relative z-10">
        <div data-animate class="w-20 h-20 rounded-full bg-gradient-to-br from-accent to-purple-600 flex items-center justify-center mx-auto mb-8 shadow-lg shadow-accent/25">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        
        <h2 data-animate class="text-3xl md:text-5xl font-display font-bold mb-6 delay-100">
          Ready to Transform Your <span class="gradient-text">Business</span>?
        </h2>
        <p data-animate class="text-white/60 text-lg mb-8 max-w-2xl mx-auto delay-200">
          Let's discuss how our {service.data.title.toLowerCase()} services can help you achieve your goals. Get a free consultation today.
        </p>
        <div data-animate class="flex flex-col sm:flex-row gap-4 justify-center delay-300">
          <a href="/#contact" class="btn-primary">
            Get Free Consultation
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="tel:+1234567890" class="btn-secondary">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call Us Now
          </a>
        </div>
      </div>
    </section>
    
    <!-- Other Services -->
    <section class="py-20 px-4 md:px-8 bg-slate-900/50">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <h2 data-animate class="text-2xl md:text-3xl font-display font-bold">
            Explore Our Other <span class="gradient-text">Services</span>
          </h2>
        </div>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {allServices.filter(s => s.id !== service.id).slice(0, 3).map((otherService, index) => (
            <a 
              href={`/services/${otherService.id}`}
              data-animate
              class={`group p-6 rounded-2xl glass hover:bg-white/10 transition-all duration-300 hover:-translate-y-1 delay-${(index + 1) * 100}`}
            >
              <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center text-accent mb-4 group-hover:bg-accent group-hover:text-white transition-all">
                <Fragment set:html={serviceIcons[otherService.id]?.replace('w-16 h-16', 'w-6 h-6') || `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`} />
              </div>
              <h3 class="text-lg font-display font-semibold mb-2 group-hover:text-accent transition-colors">
                {otherService.data.title}
              </h3>
              <p class="text-white/50 text-sm line-clamp-2">{otherService.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
    
    <!-- Navigation -->
    <section class="py-12 px-4 md:px-8 border-t border-white/5">
      <div class="max-w-4xl mx-auto flex justify-between items-center">
        {prevService ? (
          <a href={`/services/${prevService.id}`} class="group flex items-center gap-4 p-4 rounded-xl hover:bg-white/5 transition-colors">
            <div class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center group-hover:bg-accent transition-colors">
              <svg class="w-5 h-5 text-white/60 group-hover:text-white group-hover:-translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </div>
            <div class="text-left">
              <div class="text-xs text-white/40 mb-1">Previous Service</div>
              <div class="font-medium group-hover:text-accent transition-colors">{prevService.data.title}</div>
            </div>
          </a>
        ) : <div />}
        
        {nextService ? (
          <a href={`/services/${nextService.id}`} class="group flex items-center gap-4 p-4 rounded-xl hover:bg-white/5 transition-colors">
            <div class="text-right">
              <div class="text-xs text-white/40 mb-1">Next Service</div>
              <div class="font-medium group-hover:text-accent transition-colors">{nextService.data.title}</div>
            </div>
            <div class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center group-hover:bg-accent transition-colors">
              <svg class="w-5 h-5 text-white/60 group-hover:text-white group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ) : <div />}
      </div>
    </section>
  </article>
</Layout>
