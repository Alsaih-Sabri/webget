---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order);

const icons: Record<string, string> = {
  monitor: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  code: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
  search: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>`,
  palette: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>`,
  camera: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
  video: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>`,
};
---

<Layout 
  title="Our Services" 
  description="Comprehensive digital services including web design, development, SEO, graphic design, photography, and video production."
>
  <section class="section-padding pt-32 bg-primary min-h-screen">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span data-animate class="inline-block px-4 py-2 rounded-full glass text-sm font-medium text-accent mb-4">
          What We Offer
        </span>
        <h1 data-animate class="text-4xl md:text-5xl lg:text-6xl font-display font-bold mb-6 delay-100">
          Our <span class="gradient-text">Services</span>
        </h1>
        <p data-animate class="text-white/60 text-lg max-w-2xl mx-auto delay-200">
          Comprehensive digital solutions to help your business thrive online. From stunning designs to powerful development and strategic marketing.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service, index) => (
          <article 
            data-animate 
            class={`group p-8 rounded-2xl glass hover:bg-white/10 transition-all duration-500 hover:-translate-y-2 delay-${(index + 1) * 100}`}
          >
            <a href={`/services/${service.id}`} class="block">
              <div class="w-14 h-14 rounded-xl bg-accent/10 flex items-center justify-center text-accent mb-6 group-hover:bg-accent group-hover:text-white transition-all duration-300">
                <Fragment set:html={icons[service.data.icon] || icons.monitor} />
              </div>
              <h2 class="text-xl font-display font-semibold mb-3 group-hover:text-accent transition-colors">
                {service.data.title}
              </h2>
              <p class="text-white/60 leading-relaxed mb-4">
                {service.data.description}
              </p>
              <ul class="space-y-2 mb-6">
                {service.data.features.slice(0, 3).map(feature => (
                  <li class="flex items-center gap-2 text-sm text-white/50">
                    <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
              <span class="inline-flex items-center text-accent font-medium group-hover:gap-2 transition-all">
                Learn More
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </a>
          </article>
        ))}
      </div>
      
      <!-- CTA Section -->
      <div class="mt-20 text-center p-12 rounded-2xl glass" data-animate>
        <h2 class="text-2xl md:text-3xl font-display font-bold mb-4">
          Not Sure Which Service You Need?
        </h2>
        <p class="text-white/60 mb-8 max-w-xl mx-auto">
          Let's discuss your project and find the perfect solution for your business goals.
        </p>
        <a href="/#contact" class="btn-primary">
          Get a Free Consultation
        </a>
      </div>
    </div>
  </section>
</Layout>
