---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<Layout title="Blog" description="Insights, tips, and trends in web design, development, and digital marketing.">
  <section class="section-padding pt-32 bg-primary min-h-screen">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span data-animate class="inline-block px-4 py-2 rounded-full glass text-sm font-medium text-accent mb-4">
          Our Blog
        </span>
        <h1 data-animate class="text-4xl md:text-5xl lg:text-6xl font-display font-bold mb-4 delay-100">
          Insights & <span class="gradient-text">Ideas</span>
        </h1>
        <p data-animate class="text-white/60 max-w-2xl mx-auto delay-200">
          Stay updated with the latest trends, tips, and insights in web design, development, and digital marketing.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post, index) => (
          <article 
            data-animate 
            class={`group rounded-2xl overflow-hidden glass hover:bg-white/10 transition-all duration-500 delay-${(index + 1) * 100}`}
          >
            <a href={`/blog/${post.id}`} class="block">
              {post.data.image && (
                <div class="aspect-video overflow-hidden">
                  <img 
                    src={post.data.image} 
                    alt={post.data.title}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6">
                <div class="flex items-center gap-4 text-sm text-white/50 mb-3">
                  <time datetime={new Date(post.data.pubDate).toISOString()}>
                    {new Date(post.data.pubDate).toLocaleDateString('en-US', { 
                      year: 'numeric', 
                      month: 'long', 
                      day: 'numeric' 
                    })}
                  </time>
                  <span>•</span>
                  <span>{post.data.author}</span>
                </div>
                <h2 class="text-xl font-display font-semibold mb-3 group-hover:text-accent transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-white/60 line-clamp-2">
                  {post.data.description}
                </p>
                <div class="flex flex-wrap gap-2 mt-4">
                  {post.data.tags.slice(0, 3).map(tag => (
                    <span class="px-3 py-1 rounded-full bg-accent/10 text-accent text-xs">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
      
      {posts.length === 0 && (
        <div class="text-center py-20">
          <p class="text-white/60 text-lg">No blog posts yet. Check back soon!</p>
        </div>
      )}
    </div>
  </section>
</Layout>
