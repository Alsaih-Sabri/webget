---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('portfolio'))
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const featuredProjects = projects.filter(p => p.data.featured);
const otherProjects = projects.filter(p => !p.data.featured);
---

<Layout title="Portfolio" description="Explore our latest web design and development projects.">
  <section class="section-padding pt-32 bg-primary min-h-screen">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span data-animate class="inline-block px-4 py-2 rounded-full glass text-sm font-medium text-accent mb-4">
          Our Work
        </span>
        <h1 data-animate class="text-4xl md:text-5xl lg:text-6xl font-display font-bold mb-4 delay-100">
          Featured <span class="gradient-text">Projects</span>
        </h1>
        <p data-animate class="text-white/60 max-w-2xl mx-auto delay-200">
          Explore our portfolio of successful projects and see how we've helped businesses achieve their digital goals.
        </p>
      </div>
      
      <!-- Featured Projects -->
      {featuredProjects.length > 0 && (
        <div class="mb-16">
          <div class="grid lg:grid-cols-2 gap-8">
            {featuredProjects.map((project, index) => (
              <article 
                data-animate 
                class={`group rounded-2xl overflow-hidden glass hover:bg-white/10 transition-all duration-500 delay-${(index + 1) * 100}`}
              >
                <a href={`/portfolio/${project.id}`} class="block">
                  <div class="aspect-video overflow-hidden">
                    <img 
                      src={project.data.image} 
                      alt={project.data.title}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-8">
                    <div class="flex items-center gap-2 mb-4">
                      <span class="px-3 py-1 rounded-full bg-accent text-white text-xs font-medium">
                        Featured
                      </span>
                      <span class="text-white/50 text-sm">{project.data.client}</span>
                    </div>
                    <h2 class="text-2xl font-display font-semibold mb-3 group-hover:text-accent transition-colors">
                      {project.data.title}
                    </h2>
                    <p class="text-white/60 mb-4">
                      {project.data.description}
                    </p>
                    <div class="flex flex-wrap gap-2">
                      {project.data.tags.map(tag => (
                        <span class="px-3 py-1 rounded-full bg-white/5 text-white/60 text-xs">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      )}
      
      <!-- Other Projects -->
      {otherProjects.length > 0 && (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {otherProjects.map((project, index) => (
            <article 
              data-animate 
              class={`group rounded-2xl overflow-hidden glass hover:bg-white/10 transition-all duration-500 delay-${(index + 1) * 100}`}
            >
              <a href={`/portfolio/${project.id}`} class="block">
                <div class="aspect-video overflow-hidden">
                  <img 
                    src={project.data.image} 
                    alt={project.data.title}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                  />
                </div>
                <div class="p-6">
                  <span class="text-white/50 text-sm">{project.data.client}</span>
                  <h2 class="text-xl font-display font-semibold mt-2 mb-3 group-hover:text-accent transition-colors">
                    {project.data.title}
                  </h2>
                  <div class="flex flex-wrap gap-2">
                    {project.data.tags.slice(0, 3).map(tag => (
                      <span class="px-3 py-1 rounded-full bg-white/5 text-white/60 text-xs">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
      
      {projects.length === 0 && (
        <div class="text-center py-20">
          <p class="text-white/60 text-lg">No projects yet. Check back soon!</p>
        </div>
      )}
      
      <!-- CTA -->
      <div class="text-center mt-20 p-12 rounded-2xl glass">
        <h2 class="text-2xl md:text-3xl font-display font-bold mb-4">
          Ready to Start Your Project?
        </h2>
        <p class="text-white/60 mb-8 max-w-xl mx-auto">
          Let's discuss how we can help transform your digital presence and achieve your business goals.
        </p>
        <a href="/#contact" class="btn-primary">
          Get In Touch
        </a>
      </div>
    </div>
  </section>
</Layout>
