---
---

<section id="contact" class="section-padding bg-gradient-to-b from-slate-900 to-primary relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 opacity-30">
    <div class="absolute top-0 right-0 w-96 h-96 bg-accent/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-purple-500/20 rounded-full blur-3xl"></div>
  </div>
  
  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Left content -->
      <div>
        <span data-animate class="inline-block px-4 py-2 rounded-full glass text-sm font-medium text-accent mb-4">
          Get In Touch
        </span>
        <h2 data-animate class="text-3xl md:text-4xl lg:text-5xl font-display font-bold mb-6 delay-100">
          Let's Build Something <span class="gradient-text">Amazing</span> Together
        </h2>
        <p data-animate class="text-white/60 text-lg mb-8 delay-200">
          Ready to transform your digital presence? Fill out the form and we'll get back to you within 24 hours.
        </p>
        
        <div data-animate class="space-y-6 delay-300">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center text-accent">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-sm text-white/50">Email us at</div>
              <a href="mailto:hello@webget.com" class="text-white hover:text-accent transition-colors">hello@webget.com</a>
            </div>
          </div>
          
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center text-accent">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <div class="text-sm text-white/50">Call us at</div>
              <a href="tel:+1234567890" class="text-white hover:text-accent transition-colors">+1 (234) 567-890</a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Form -->
      <div data-animate class="delay-200">
        <form 
          id="contact-form"
          class="p-8 rounded-2xl glass"
          action="#"
          method="POST"
        >
          <div class="grid sm:grid-cols-2 gap-6 mb-6">
            <div>
              <label for="name" class="block text-sm font-medium text-white/80 mb-2">
                Full Name *
              </label>
              <input 
                type="text" 
                id="name" 
                name="name"
                required
                autocomplete="name"
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30 focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all"
                placeholder="John Doe"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-white/80 mb-2">
                Email Address *
              </label>
              <input 
                type="email" 
                id="email" 
                name="email"
                required
                autocomplete="email"
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30 focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all"
                placeholder="john@example.com"
              />
            </div>
          </div>
          
          <div class="mb-6">
            <label for="service" class="block text-sm font-medium text-white/80 mb-2">
              Service Interested In
            </label>
            <select 
              id="service" 
              name="service"
              class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all appearance-none cursor-pointer"
            >
              <option value="" class="bg-primary">Select a service</option>
              <option value="web-design" class="bg-primary">Web Design</option>
              <option value="web-development" class="bg-primary">Web Development</option>
              <option value="seo" class="bg-primary">SEO Optimization</option>
              <option value="photography" class="bg-primary">Photography</option>
              <option value="video" class="bg-primary">Video Production</option>
              <option value="graphic-design" class="bg-primary">Graphic Design</option>
            </select>
          </div>
          
          <div class="mb-6">
            <label for="message" class="block text-sm font-medium text-white/80 mb-2">
              Your Message *
            </label>
            <textarea 
              id="message" 
              name="message"
              required
              rows="4"
              class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30 focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all resize-none"
              placeholder="Tell us about your project..."
            ></textarea>
          </div>
          
          <button 
            type="submit"
            class="w-full btn-primary justify-center"
          >
            Send Message
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
          
          <p class="text-xs text-white/40 text-center mt-4">
            By submitting this form, you agree to our privacy policy.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = Object.fromEntries(formData);
    
    // Here you would typically send to your backend/API
    console.log('Form submitted:', data);
    
    // Show success message (replace with actual implementation)
    alert('Thank you! We\'ll be in touch soon.');
    form.reset();
  });
</script>
