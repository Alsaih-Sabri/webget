---
const services = [
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
    title: 'Web Design',
    slug: 'web-design',
    description: 'Beautiful, modern websites that captivate your audience and reflect your brand identity perfectly.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    title: 'Web Development',
    slug: 'web-development',
    description: 'Robust, scalable web applications built with cutting-edge technologies and best practices.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>`,
    title: 'SEO Optimization',
    slug: 'seo-optimization',
    description: 'Data-driven strategies to boost your search rankings and drive organic traffic to your site.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
    title: 'Photography',
    slug: 'photography',
    description: 'Professional photography services to capture your brand, products, and moments beautifully.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>`,
    title: 'Video Production',
    slug: 'video-production',
    description: 'Engaging video content and animations that tell your story and connect with your audience.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>`,
    title: 'Graphic Design',
    slug: 'graphic-design',
    description: 'Creative visual solutions including logos, branding, and marketing materials that stand out.',
  },
];
---

<section id="services" class="section-padding bg-gradient-to-b from-primary to-slate-900">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <span data-animate class="inline-block px-4 py-2 rounded-full glass text-sm font-medium text-accent mb-4">
        What We Do
      </span>
      <h2 data-animate class="text-3xl md:text-4xl lg:text-5xl font-display font-bold mb-4 delay-100">
        Our <span class="gradient-text">Services</span>
      </h2>
      <p data-animate class="text-white/60 max-w-2xl mx-auto delay-200">
        We offer comprehensive digital solutions to help your business thrive in the modern digital landscape.
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service, index) => (
        <a 
          href={`/services/${service.slug}`}
          data-animate 
          class={`group block p-8 rounded-2xl glass hover:bg-white/10 transition-all duration-500 hover:-translate-y-2 delay-${(index + 1) * 100}`}
        >
          <div class="w-14 h-14 rounded-xl bg-accent/10 flex items-center justify-center text-accent mb-6 group-hover:bg-accent group-hover:text-white transition-all duration-300">
            <Fragment set:html={service.icon} />
          </div>
          <h3 class="text-xl font-display font-semibold mb-3 group-hover:text-accent transition-colors">
            {service.title}
          </h3>
          <p class="text-white/60 leading-relaxed mb-4">
            {service.description}
          </p>
          <span class="inline-flex items-center text-accent text-sm font-medium">
            Learn More
            <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      ))}
    </div>
    
    <div class="text-center mt-12">
      <a href="/services" class="btn-secondary">
        View All Services
      </a>
    </div>
  </div>
</section>
