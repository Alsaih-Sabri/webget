---
---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Animated Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary via-slate-900 to-primary">
    <div class="absolute inset-0 opacity-30">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-accent/20 rounded-full blur-3xl animate-float"></div>
      <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-purple-500/20 rounded-full blur-3xl animate-float" style="animation-delay: -3s;"></div>
      <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-pink-500/20 rounded-full blur-3xl animate-float" style="animation-delay: -1.5s;"></div>
    </div>
    <!-- Grid pattern -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
  </div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-8 text-center">
    <div data-animate class="mb-6">
      <span class="inline-block px-4 py-2 rounded-full glass text-sm font-medium text-accent">
        ✨ Premium Digital Services
      </span>
    </div>
    
    <h1 
      data-animate 
      class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-bold leading-tight mb-6 delay-100"
    >
      We Build
      <span class="gradient-text"> Digital Experiences</span>
      <br />That Convert
    </h1>
    
    <p 
      data-animate 
      class="text-lg md:text-xl text-white/70 max-w-2xl mx-auto mb-10 delay-200"
    >
      Transform your online presence with stunning web design, cutting-edge development, 
      and data-driven SEO strategies that drive real results.
    </p>
    
    <div data-animate class="flex flex-col sm:flex-row items-center justify-center gap-4 delay-300">
      <a href="#contact" class="btn-primary">
        Start Your Project
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a href="#portfolio" class="btn-secondary">
        View Our Work
      </a>
    </div>
    
    <!-- Stats -->
    <div data-animate class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-20 pt-10 border-t border-white/10 delay-400">
      <div>
        <div class="text-3xl md:text-4xl font-display font-bold text-accent">150+</div>
        <div class="text-sm text-white/60 mt-1">Projects Delivered</div>
      </div>
      <div>
        <div class="text-3xl md:text-4xl font-display font-bold text-accent">98%</div>
        <div class="text-sm text-white/60 mt-1">Client Satisfaction</div>
      </div>
      <div>
        <div class="text-3xl md:text-4xl font-display font-bold text-accent">5+</div>
        <div class="text-sm text-white/60 mt-1">Years Experience</div>
      </div>
      <div>
        <div class="text-3xl md:text-4xl font-display font-bold text-accent">24/7</div>
        <div class="text-sm text-white/60 mt-1">Support Available</div>
      </div>
    </div>
  </div>
  
  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <a href="#services" aria-label="Scroll to services" class="block p-2">
      <svg class="w-6 h-6 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>
